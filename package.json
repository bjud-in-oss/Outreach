{
  "name": "outreach-engine",
  "private": true,
  "version": "14.4.0",
  "type": "module",
  "scripts": {
    "samrad": "tsx --env-file=.env scripts/samrad.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "planera": "echo '❌ [AVVECKLAT KRYPHÅL] pnpm planera är spärrat. Använd pnpm bygg [TCK-XXX] istället.' && exit 1",
    "genomfor": "echo '❌ [AVVECKLAT KRYPHÅL] pnpm genomfor är spärrat. Använd pnpm bygg [TCK-XXX] istället.' && exit 1",
    "bygg": "tsx --env-file=.env scripts/run-planera-live.ts",
    "test:transient": "vitest run src/__tests__/transient_TCK-TEST-001.test.ts",
    "verify": "pnpm test && node scripts/verify-architecture.js && pnpm update-index",
    "test": "node --import tsx scripts/run-tests.js",
    "update-index": "node scripts/generate-feature-index.js",
    "synka": "tsx --env-file=.env scripts/synka.ts",
    "compress-adrs": "node scripts/compress-adrs.js",
    "start": "pnpm samrad"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}