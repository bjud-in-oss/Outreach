+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { GeminiLiveSession } from '../features/gemini_live_swarm/session/geminiLiveSession';
+import { SwarmEventBus } from '../features/gemini_live_swarm/bus/swarmEventBus';
+import { SwarmAudioChannel } from '../features/gemini_live_swarm/index';
+
+describe('transient_TCK-052.test.tsx - End-to-End Live Bridge Integration', () => {
+  let eventBus: SwarmEventBus;
+  let session: GeminiLiveSession;
+
+  beforeEach(() => {
+    eventBus = new SwarmEventBus();
+    session = new GeminiLiveSession('test-api-key', eventBus);
+  });
+
+  afterEach(() => {
+    eventBus.clear();
+  });
+
+  it('verifies liveBridgeHelper integration end-to-end via GeminiLiveSession', () => {
+    const emittedEvents: Array<{ type: string; payload: any }> = [];
+    
+    // Subscriba till alla relevanta event på event busen för att validera utfall
+    eventBus.subscribe('*', (event) => {
+      emittedEvents.push({ type: event.type, payload: event.data });
+    });
+
+    // 1. Validera intent aktivering/inaktivering
+    eventBus.emit('swarm.live.intent.activated', { data: { title: 'Att förlikas' } });
+    
+    const renderEvents = emittedEvents.filter(e => e.type === 'a2ui:render');
+    const clearEvents = emittedEvents.filter(e => e.type === 'a2ui:clear');
+
+    expect(renderEvents.length).toBeGreaterThan(0);
+    expect(renderEvents[renderEvents.length - 1].payload.componentId).toBe('ListeningCard');
+
+    eventBus.emit('swarm.live.intent.deactivated', {});
+    expect(emittedEvents.some(e => e.type === 'a2ui:clear')).toBe(true);
+
+    // 2. Validera output transkription via handleAgentMessage
+    const transcriptionMessage = {
+      serverContent: {
+        outputTranscription: {
+          text: 'Hej från rösten'
+        }
+      }
+    };
+
+    session.handleAgentMessage('forlikas' as SwarmAudioChannel, transcriptionMessage);
+
+    const textDeltaEvents = emittedEvents.filter(e => e.type === 'swarm.session.text_delta');
+    expect(textDeltaEvents.length).toBeGreaterThan(0);
+    expect(textDeltaEvents[textDeltaEvents.length - 1].payload.text).toBe('Hej från rösten');
+
+    // 3. Validera tool call hantering och verktygssvar
+    const toolCallMessage = {
+      toolCall: {
+        functionCalls: [
+          {
+            id: 'c1',
+            name: 'render_a2ui',
+            args: {
+              componentId: 'ActionPrompt',
+              dataModel: { actionLabel: 'Kör' }
+            }
+          }
+        ]
+      }
+    };
+
+    session.handleAgentMessage('forlikas' as SwarmAudioChannel, toolCallMessage);
+
+    const a2uiRenderEvents = emittedEvents.filter(e => e.type === 'a2ui:render');
+    expect(a2uiRenderEvents.length).toBeGreaterThan(renderEvents.length);
+    expect(a2uiRenderEvents[a2uiRenderEvents.length - 1].payload.componentId).toBe('ActionPrompt');
+  });
+});
