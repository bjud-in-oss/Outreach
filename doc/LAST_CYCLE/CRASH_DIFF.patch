+
+  it('ska kasta fel om API-nyckel är tom sträng', async () => {
+    const adapter = skapaBidiLiveAdapter({ apiKey: '' });
+    const prompt: CompiledPrompt = { userPrompt: 'Hej' };
+
+    await expect(adapter.skicka(prompt)).rejects.toThrow(
+      'API-nyckel saknas för Gemini Live SDK'
+    );
+  });
+});
