@@ -0,0 +1,47 @@
+import { render, act } from '@testing-library/react';
+import { describe, it, expect, beforeEach } from 'vitest';
+import React from 'react';
+import { A2UIContainer } from '../features/a2ui/engine/A2UIContainer';
+import { SwarmEventBus } from '../features/gemini_live_swarm/bus/swarmEventBus';
+
+describe('A2UIContainer Transient Test', () => {
+  let eventBus: SwarmEventBus;
+
+  beforeEach(() => {
+    eventBus = new SwarmEventBus();
+  });
+
+  it('should be hidden by default and render ListeningCard on a2ui:render', () => {
+    const { container } = render(<A2UIContainer bus={eventBus} />);
+    
+    // 1. Dold som standard
+    expect(container.firstChild).toBeNull();
+
+    // 2. Simulera a2ui:render
+    act(() => {
+      eventBus.emit('a2ui:render', { componentId: 'ListeningCard' });
+    });
+
+    // Kontrollera att komponenten nu renderas
+    // Eftersom vi inte har katalogen än bör den väl falla tillbaka eller krascha, 
+    // men vi förväntar oss att den försöker rendera något annat än null.
+    expect(container.firstChild).not.toBeNull();
+  });
+
+  it('should clear state on a2ui:clear', () => {
+    const { container } = render(<A2UIContainer bus={eventBus} />);
+
+    act(() => {
+      eventBus.emit('a2ui:render', { componentId: 'ListeningCard' });
+    });
+
+    expect(container.firstChild).not.toBeNull();
+
+    act(() => {
+      eventBus.emit('a2ui:clear', {});
+    });
+
+    // Ska återgå till dold
+    expect(container.firstChild).toBeNull();
+  });
+});
