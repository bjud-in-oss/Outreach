@@ -0,0 +1,68 @@
+import { expect, test } from 'vitest';
+import { inspectTestAlibis } from '../features/path/engine/alibiInspector';
+import { skapaProvningsport } from '../features/path/engine/provningsport';
+import { exekveraRecept } from '../features/path/engine/pathRunner';
+import { PathContext, PathRecipe } from '../features/path/model/types';
+import { PortNekadError } from '../features/path/engine/pathRunner';
+
+test('inspectTestAlibis detects tautologies and alibis in memory', () => {
+  const alibi1 = "expect(true).toBe(true);";
+  const result1 = inspectTestAlibis(alibi1);
+  expect(result1.godkand).toBe(false);
+  expect(result1.felmeddelande).toContain('Tautologisk assertion');
+
+  const alibi2 = "fs.readFileSync('file.txt');";
+  const result2 = inspectTestAlibis(alibi2);
+  expect(result2.godkand).toBe(false);
+  expect(result2.felmeddelande).toContain('fs.readFileSync');
+
+  const alibi3 = "vi.fn();";
+  const result3 = inspectTestAlibis(alibi3);
+  expect(result3.godkand).toBe(false);
+  expect(result3.felmeddelande).toContain('vi.fn()');
+
+  const validCode = "expect(someVar).toBe(true);";
+  const resultValid = inspectTestAlibis(validCode);
+  expect(resultValid.godkand).toBe(true);
+});
+
+test('skapaProvningsport rejects port if test contains alibi', async () => {
+  const testExekverare = async (vag: string) => ({ passera: false });
+  const port = skapaProvningsport({
+    testFilVag: 'test.ts',
+    forvantatFel: 'Fail',
+    testExekverare,
+    testKod: 'expect(true).toBe(true);'
+  });
+
+  const result = await port({});
+  expect(result.oppnad).toBe(false);
+  expect(result.omvandelseKrav).toBe('ÅTGÄRDA_TESTSYNTAX');
+});
+
+test('exekveraRecept handles maxOmvandelseForsok and triggers onOmvandelse', async () => {
+  let omvandelseAnropad = 0;
+  const failingPort = async (ctx: PathContext) => {
+    throw new PortNekadError('Port nekad', 'ÅTGÄRDA_TESTSYNTAX');
+  };
+
+  const recipe: PathRecipe = {
+    id: 'rec-1',
+    name: 'Recept',
+    description: 'Beskrivning',
+    nodes: [{ id: 'avsikt-1', type: 'PORT', port: failingPort }]
+  };
+
+  try {
+    await exekveraRecept(recipe, {}, {
+      maxOmvandelseForsok: 2,
+      onOmvandelse: () => {
+        omvandelseAnropad++;
+      }
+    });
+  } catch (err) {
+    // Förväntat fel
+  }
+
+  expect(omvandelseAnropad).toBe(2);
+});
