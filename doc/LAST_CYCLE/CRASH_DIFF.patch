 function runCheck(command: string, name: string) {
   console.log(`\n🔍 [MAINT]: Kör ${name}...`);
   try {
-    execSync(command, { stdio: 'inherit', cwd: process.cwd() });
+    execSync(command, { stdio: 'pipe', cwd: process.cwd(), encoding: 'utf-8' });
   } catch (err: any) {
+    const output = err.stdout || '';
+    const errOutput = err.stderr || '';
+    const fullLog = output + errOutput;
+
     console.error(`❌ [MAINT]: ${name} fallerade.`);
+
+    const errorPatterns = /Error|FAIL|Transform failed|SyntaxError|TypeError|AssertionError|error TS|RADGRÄNSBROTT|✘|File:/;
+    const lines = fullLog.split('\n');
+    const matchedLines = new Set<number>();
+
+    for (let i = 0; i < lines.length; i++) {
+        if (errorPatterns.test(lines[i])) {
+            for (let j = Math.max(0, i - 3); j <= Math.min(lines.length - 1, i + 3); j++) {
+                matchedLines.add(j);
+            }
+        }
+    }
+
+    const sortedLines = Array.from(matchedLines).sort((a, b) => a - b);
+    const extractedLines = sortedLines.slice(0, 25).map(idx => lines[idx]).join('\n');
+
+    console.error('\n--- EXTRAHERADE FEL (HÖGSTSTÅENDEUTSATS) ---');
+    console.error(extractedLines);
+    console.error('--------------------------------------------\n');
+    console.error('FULLSTÄNDIG LOGG NEDAN:');
+    console.error(fullLog);
+
     process.exit(1);
   }
 }
