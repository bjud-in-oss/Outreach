@@ -0,0 +1,37 @@
+import { render, act, screen } from '@testing-library/react';
+import { describe, it, expect, beforeEach } from 'vitest';
+import { A2UIContainer } from '../features/a2ui/engine/A2UIContainer';
+import { SwarmEventBus } from '../shared/bus/swarmEventBus';
+
+describe('A2UIContainer TCK-050', () => {
+  let eventBus: SwarmEventBus;
+
+  beforeEach(() => {
+    eventBus = new SwarmEventBus();
+  });
+
+  it('renders nothing when initialized and responds to a2ui:render and a2ui:clear events', () => {
+    const { container } = render(<A2UIContainer bus={eventBus} />);
+    
+    // Att Vända OM: Förblir tyst och returnerar null i viloläge
+    expect(container.firstChild).toBeNull();
+
+    // Att FÖLJA: Rendera ListeningCard vid a2ui:render
+    act(() => {
+      eventBus.publish('a2ui:render', {
+        componentId: 'listening-card',
+        dataModel: { prompt: 'Laddar...' }
+      });
+    });
+
+    // Verifiera att kortet visas
+    expect(screen.getByText(/Laddar.../i)).toBeDefined();
+
+    // Att Vända OM: Återgå till null vid a2ui:clear
+    act(() => {
+      eventBus.publish('a2ui:clear', {});
+    });
+
+    expect(container.firstChild).toBeNull();
+  });
+});
