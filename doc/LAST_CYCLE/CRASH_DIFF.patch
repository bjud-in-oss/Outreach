+import { describe, it, expect } from 'vitest';
+import { skapaBidiLiveAdapter } from '../features/path/engine/bidiLiveAdapter';
+import { CompiledPrompt } from '../features/path/contracts/pathSchema';
+
+describe('BidiLiveAdapter SDKfabrik (TCK-054)', () => {
+  it('ska kasta fel om API-nyckel saknas och ingen clientFactory finns', async () => {
+    const adapter = skapaBidiLiveAdapter({});
+    const prompt: CompiledPrompt = { userPrompt: 'Hej' };
+
+    await expect(adapter.skicka(prompt)).rejects.toThrow(
+      'API-nyckel saknas för Gemini Live SDK'
+    );
