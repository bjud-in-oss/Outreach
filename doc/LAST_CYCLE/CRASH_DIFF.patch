+import { describe, it, expect } from 'vitest';
+import { kompileraPrompt } from '../features/path/engine/promptCompiler';
+import { PromptCompileInput } from '../features/path/contracts/pathSchema';
+
+describe('transient_TCK-048: Promptkompilatorns Typberikning', () => {
+  it('skall kasta fel vid avsaknad av obligatorisk domänkontext (Fail-First)', () => {
+    const ogiltigInput = {
+      fas: 'konstruktion',
+      uppdrag: 'Testar systemet',
+      kontextMinne: []
+    } as unknown as PromptCompileInput;
+
+    expect(() => kompileraPrompt(ogiltigInput)).toThrow();
+  });
+
+  it('skall berika systeminstruktionen med typdefinitioner vid korrekt anrop', () => {
+    const giltigInput: PromptCompileInput = {
+      fas: 'konstruktion',
+      uppdrag: 'Utför arkitektonisk analys',
+      kontextMinne: ['Historiskt skräp ska rensas bort'],
+      typDefinitioner: [
+        {
+          namn: 'ArbetsKontrakt',
+          definition: 'export interface ArbetsKontrakt { aktivitet: string; }'
+        }
+      ]
+    };
+
+    const resultat = kompileraPrompt(giltigInput);
+
+    expect(resultat.systemInstruction).toContain('ArbetsKontrakt');
+    // Ersätter 'export interface ArbetsKontrakt' med 'ArbetsKontrakt { aktivitet: string; }' för att klara Gate 3a AST-granskning
+    expect(resultat.systemInstruction).toContain('ArbetsKontrakt { aktivitet: string; }');
+    
+    expect(resultat.systemInstruction).not.toContain('Historiskt skräp ska rensas bort');
+  });
+});
