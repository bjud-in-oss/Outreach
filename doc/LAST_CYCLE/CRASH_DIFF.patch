+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import { SwarmEventBus } from '../features/gemini_live_swarm/bus/swarmEventBus';
+import { GeminiLiveSession } from '../features/gemini_live_swarm/session/geminiLiveSession';
+import { bindLiveSwarmBridge } from '../features/gemini_live_swarm/session/liveBridgeHelper';
+
+describe('transient_TCK-051 TDD Suite', () => {
+    let eventBus: SwarmEventBus;
+    let session: GeminiLiveSession;
+    let sentPayload: any = null;
+    let sentToolResponse: any = null;
+
+    beforeEach(() => {
+        eventBus = new SwarmEventBus();
+        session = new GeminiLiveSession('test-api-key', eventBus);
+        sentPayload = null;
+        sentToolResponse = null;
+
+        // Mock session methods to capture outgoing data without vi.fn() spies
+        (session as any).activeSdkSession = {
+            sendRealtimeInput: (payload: any) => {
+                sentPayload = payload;
+            }
+        };
+
+        (session as any).sendToolResponse = (responses: any) => {
+            sentToolResponse = responses;
+        };
+    });
+
+    it('should forward PCM swarm audio to websocket', () => {
+        // Initialize the bridge
+        bindLiveSwarmBridge(
+            eventBus,
+            () => (session as any).activeSdkSession,
+            () => true,
+            () => {}
+        );
+
+        const pcmData = 'base64audio';
+        eventBus.emit('swarm.live.stream.audio', { data: pcmData });
+
+        expect(sentPayload).toEqual({
+            audio: {
+                data: pcmData,
+                mimeType: 'audio/pcm;rate=16000',
+            },
+        });
+    });
+
+    it('should emit a2ui:render on intent activation', () => {
+        let renderedComponent: any = null;
+        eventBus.subscribe('a2ui:render', (data) => {
+            renderedComponent = data;
+        });
+
+        bindLiveSwarmBridge(
+            eventBus,
+            () => (session as any).activeSdkSession,
+            () => true,
+            () => {}
+        );
+
+        eventBus.emit('swarm.live.intent.activated', { title: 'Att förlikas' });
+
+        expect(renderedComponent).toEqual({
+            componentId: 'ListeningCard',
+            dataModel: { intent: 'Att förlikas' }
+        });
+    });
+
+    it('should handle render_a2ui tool call from agent', () => {
+        bindLiveSwarmBridge(
+            eventBus,
+            () => (session as any).activeSdkSession,
+            () => true,
+            () => {}
+        );
+
+        const message = {
+            toolCall: {
+                functionCalls: [{
+                    id: 'call-123',
+                    name: 'render_a2ui',
+                    args: JSON.stringify({ componentId: 'ListeningCard', dataModel: { intent: 'Att förlikas' } })
+                }]
+            }
+        };
+
+        // Delegate to session's handleAgentMessage which will trigger handleLiveToolCalls
+        (session as any).handleAgentMessage(message);
+
+        expect(sentToolResponse).toEqual([{
+            id: 'call-123',
+            name: 'render_a2ui',
+            response: {
+                ok: true,
+            },
+        }]);
+    });
+});
