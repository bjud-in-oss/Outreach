+import { describe, it, expect, beforeEach } from 'vitest';
+import { getGlobalSwarmEventBus, SwarmEventBus } from '../features/gemini_live_swarm/bus/swarmEventBus';
+import { GeminiLiveSession } from '../features/gemini_live_swarm/session/geminiLiveSession';
+import { SessionIntentManager } from '../features/gemini_live_swarm/session/sessionIntentAudio';
+
+describe('TCK-051 Transient Integration Tests', () => {
+  let eventBus: SwarmEventBus;
+
+  beforeEach(() => {
+    eventBus = getGlobalSwarmEventBus();
+    eventBus.clear();
+  });
+
+  it('Requirement 1: Routes PCM audio from event bus to Gemini SDK session', async () => {
+    let capturedAudioData: any = null;
+    let sendRealtimeInputCalled = false;
+
+    // We do not mock with vi.fn(), we instantiate a minimal class implementing the expected interface
+    class MockSession {
+      async sendRealtimeInput(payload: any) {
+        sendRealtimeInputCalled = true;
+        capturedAudioData = payload;
+      }
+    }
+
+    const mockSession = new MockSession() as any;
+    const session = new GeminiLiveSession(mockSession);
+
+    // Act
+    const testData = new Uint8Array([1, 2, 3, 4]).buffer;
+    eventBus.emit('swarm.live.stream.audio', {
+      data: testData,
+      mimeType: 'audio/pcm'
+    });
+
+    // Wait for async processing if any
+    await new Promise(resolve => setTimeout(resolve, 50));
+
+    // Assert
+    expect(sendRealtimeInputCalled).toBe(true);
+    expect(capturedAudioData).toEqual({
+      audio: {
+        data: testData,
+        mimeType: 'audio/pcm'
+      }
+    });
+  });
+
+  it('Requirement 2: Publishes a2ui events on intent activation', () => {
+    let capturedEvent: any = null;
+    eventBus.subscribe('a2ui:render', (data) => {
+      capturedEvent = data;
+    });
+
+    const intentManager = new SessionIntentManager(eventBus);
+
+    // Act
+    intentManager.activateIntent('test-intent', { title: 'Voice Activated Intent' });
+
+    // Assert
+    expect(capturedEvent).toBeDefined();
+    expect(capturedEvent.componentId).toBe('ListeningCard');
+    expect(capturedEvent.dataModel.intent).toBe('Voice Activated Intent');
+  });
+
+  it('Requirement 3: Clears a2ui events on intent deactivation', () => {
+    let clearTriggered = false;
+    eventBus.subscribe('a2ui:clear', () => {
+      clearTriggered = true;
+    });
+
+    const intentManager = new SessionIntentManager(eventBus);
+
+    // Act
+    intentManager.deactivateIntent();
+
+    // Assert
+    expect(clearTriggered).toBe(true);
+  });
+});
