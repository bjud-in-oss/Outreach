diff --git a/src/features/path/__tests__/tck-064.test.ts b/src/features/path/__tests__/tck-064.test.ts
new file mode 100644
index 0000000..c93e7e5
--- /dev/null
+++ b/src/features/path/__tests__/tck-064.test.ts
@@ -0,0 +1,69 @@
+import { describe, it, expect } from 'vitest';
+import { 
+  PromptCompileInputSchema, 
+  CompiledPromptSchema, 
+  ProvningsportOptionsSchema,
+  BidiLiveAdapterConfigSchema,
+  OrchestratorConfigSchema
+} from '../contracts/pathSchema';
+import type { StepNode, PortNode } from '../model/types';
+
+describe('TCK-064 Schema och Typkontroller', () => {
+
+  it('ska validera struktur för BidiLiveAdapterConfigSchema defaultvärden', () => {
+    const config = BidiLiveAdapterConfigSchema.parse({});
+    expect(config.maxReconnectAttempts).toBe(6);
+  });
+
+  it('ska validera OrchestratorConfigSchema nya fält', () => {
+    const config = OrchestratorConfigSchema.parse({
+      receptTyp: 'classic',
+      ticketId: 'TCK-123',
+      malDoman: 'path',
+      uppdrag: 'test'
+    });
+    expect(config.uppdragsTyp).toBe('TCK');
+    expect(config.maxYttreOmvandelseForsok).toBe(4);
+  });
+
+  it('ska verifiera att PromptCompileInputSchema inte har duplicerade nycklar', () => {
+    const shape = PromptCompileInputSchema.shape;
+    expect(shape).toHaveProperty('malDoman');
+    expect(shape).toHaveProperty('stegId');
+    expect(shape).toHaveProperty('ticketId');
+    
+    const keys = Object.keys(shape);
+    const uniqueKeys = new Set(keys);
+    expect(keys.length).toBe(uniqueKeys.size);
+  });
+
+  it('ska verifiera tillägg i CompiledPromptSchema och ProvningsportOptionsSchema', () => {
+    const compiledPrompt = CompiledPromptSchema.shape;
+    expect(compiledPrompt).toHaveProperty('systemPrompt');
+
+    const provningsport = ProvningsportOptionsSchema.shape;
+    expect(provningsport).toHaveProperty('testKod');
+  });
+
+  it('ska representera StepNode och PortNode med valfri run-metod i typer', () => {
+    // Denna test säkerställer kompilering och typ-matchning för TS-gränssnitten
+    const stepNode: StepNode = {
+      id: 'step1',
+      name: 'Step 1',
+      type: 'STEP',
+      execute: async () => ({ success: true }),
+      run: async () => ({ success: true }) // Valfri, men testas här att den accepteras
+    };
+
+    const portNode: PortNode = {
+      id: 'port1',
+      name: 'Port 1',
+      type: 'PORT',
+      port: async () => ({ oppnad: true }),
+      run: async () => ({ oppnad: true }) // Valfri
+    };
+
+    expect(stepNode.type).toBe('STEP');
+    expect(portNode.type).toBe('PORT');
+  });
+});
