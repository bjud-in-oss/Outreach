+import { describe, it, expect } from 'vitest';
+import { skapaBidiLiveAdapter } from '../features/path/engine/bidiLiveAdapter';
+
+describe('BidiLiveAdapter Återanslutning (TCK-059)', () => {
+  it('ska återansluta med backoff och jitter vid transienta fel', async () => {
+    const emittedErrors: unknown[] = [];
+    let closedSessions = 0;
+    let attempts = 0;
+
+    const mockEventBus = {
+      emit: (type: string, err: unknown) => {
+        if (type === 'error') {
+          emittedErrors.push(err);
+        }
+      }
+    };
+
+    class MockSession {
+      constructor() {
+        attempts++;
+      }
+      async sendClientContent(_opts: any) {
+        // Försök 1 & 2 kastar fel i receiveStream, så vi behöver inte fejka här
+      }
+      async *receiveStream(): AsyncGenerator<any, void, unknown> {
+        if (attempts === 1) {
+          throw new Error('WebSocket error 1011: Transient Failure');
+        }
+        if (attempts === 2) {
+          throw new Error('WebSocket error 1006: Connection Lost');
+        }
+        // Försök 3 lyckas
+        yield {
+          serverContent: {
+            modelTurn: {
+              parts: [{ text: 'Lyckat svar på försök 3' }]
+            }
+          }
+        };
+      }
+      async close() {
+        closedSessions++;
+      }
+    }
+
+    class MockLive {
+      async connect(_opts: any) {
+        return new MockSession();
+      }
+    }
+
+    class MockSdk {
+      live = new MockLive();
+    }
+
+    const adapter = skapaBidiLiveAdapter({
+      apiKey: 'test-key',
+      baseBackoffMs: 5,
+      maxJitterMs: 5,
+      eventBus: mockEventBus,
+      sdkConstructor: () => new MockSdk()
+    });
+
+    const resultat = await adapter.skicka({
+      userPrompt: 'Hej'
+    });
+
+    expect(resultat.svar).toBe('Lyckat svar på försök 3');
+    expect(attempts).toBe(3);
+    expect(closedSessions).toBe(3);
+    expect(emittedErrors.length).toBe(0);
+  });
+});
