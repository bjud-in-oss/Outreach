+import { describe, it, expect, beforeEach } from 'vitest';
+import { GeminiLiveSession } from '../features/gemini_live_swarm/session/geminiLiveSession';
+import { SwarmEventBus } from '../features/gemini_live_swarm/bus/swarmEventBus';
+
+describe('TCK-053: VAD End Signal and Latency Telemetry', () => {
+  let eventBus: SwarmEventBus;
+  let session: GeminiLiveSession;
+
+  beforeEach(() => {
+    eventBus = new SwarmEventBus();
+    session = new GeminiLiveSession('test-api-key', eventBus);
+  });
+
+  it('should emit audio_end and send audioStreamEnd: true when VAD stops', async () => {
+    let audioEndEmitted = false;
+    let audioStreamEndSent = false;
+
+    eventBus.subscribe('swarm.live.stream.audio_end', () => {
+      audioEndEmitted = true;
+    });
+
+    // Mock the internal activeSdkSession to verify audioStreamEnd
+    // @ts-ignore
+    session.activeSdkSession = {
+      sendRealtimeInput: (payload: any) => {
+        if (payload.audioStreamEnd === true) {
+          audioStreamEndSent = true;
+        }
+      }
+    };
+
+    // @ts-ignore - access intent manager and simulate VAD streaming
+    const intentManager = session.sessionIntentManager;
+    
+    // Simulate high amplitude chunk (Talking)
+    intentManager.processIncomingChunk(new Float32Array([0.5, 0.8, 0.9]));
+
+    // Fast-forward time to simulate silence and post-roll
+    await new Promise(resolve => setTimeout(resolve, 600));
+
+    // Send another chunk after silence to trigger VAD end
+    intentManager.processIncomingChunk(new Float32Array([0.0]));
+
+    expect(audioEndEmitted).toBe(true);
+    expect(audioStreamEndSent).toBe(true);
+  });
+
+  it('should emit telemetry:voice_latency when agent responds after audio stream end', async () => {
+    let latencyEmitted = false;
+    let emittedLatency = 0;
+
+    eventBus.subscribe('telemetry:voice_latency', (data: any) => {
+      latencyEmitted = true;
+      emittedLatency = data.vadToFirstByteMs;
+    });
+
+    // @ts-ignore
+    session.activeSdkSession = {
+      sendRealtimeInput: () => {}
+    };
+
+    // @ts-ignore
+    const intentManager = session.sessionIntentManager;
+    
+    // Trigger VAD end setup
+    intentManager.processIncomingChunk(new Float32Array([0.1]));
+    await new Promise(resolve => setTimeout(resolve, 600));
+    intentManager.processIncomingChunk(new Float32Array([0]));
+
+    // Simulate agent response
+    session.handleAgentMessage('forlikas', { 
+      serverContent: { 
+        outputTranscription: { text: 'Svar' } 
+      } 
+    });
+
+    expect(latencyEmitted).toBe(true);
+    expect(emittedLatency).toBeGreaterThanOrEqual(0);
+  });
+});
