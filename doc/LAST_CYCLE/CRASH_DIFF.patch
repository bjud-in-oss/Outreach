@@ -0,0 +1,32 @@
+import React, { useEffect, useState } from 'react';
+import { SwarmEventBus } from '../../gemini_live_swarm/bus/swarmEventBus';
+import { A2UIPayload } from '../model/types';
+import { RenderA2UI } from './renderer';
+
+interface A2UIContainerProps {
+  bus: SwarmEventBus;
+}
+
+export const A2UIContainer: React.FC<A2UIContainerProps> = ({ bus }) => {
+  const [payload, setPayload] = useState<A2UIPayload | null>(null);
+
+  useEffect(() => {
+    const handleRender = (data: A2UIPayload) => {
+      setPayload(data);
+    };
+
+    const handleClear = () => {
+      setPayload(null);
+    };
+
+    bus.on('a2ui:render', handleRender);
+    bus.on('a2ui:clear', handleClear);
+
+    return () => {
+      bus.off('a2ui:render', handleRender);
+      bus.off('a2ui:clear', handleClear);
+    };
+  }, [bus]);
+
+  return <>{RenderA2UI(payload)}</>;
+};
