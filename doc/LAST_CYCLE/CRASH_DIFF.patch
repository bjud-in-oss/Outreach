+import { render, screen, act } from '@testing-library/react';
+import { describe, it, expect, beforeEach } from 'vitest';
+import { A2UIContainer } from '../features/a2ui/engine/A2UIContainer';
+import { SwarmEventBus } from '../shared/bus/swarmEventBus';
+
+describe('A2UIContainer', () => {
+  let eventBus: SwarmEventBus;
+
+  beforeEach(() => {
+    eventBus = new SwarmEventBus();
+  });
+
+  it('ska börja dolt och rendera ListeningCard vid a2ui:render samt rensas vid a2ui:clear', () => {
+    const { container } = render(<A2UIContainer bus={eventBus} />);
+
+    // Givet att A2UIContainer är monterad och inget renderats än
+    expect(container.firstChild).toBeNull();
+
+    // När händelsen a2ui:render publiceras med ListeningCard
+    act(() => {
+      eventBus.publish('a2ui:render', {
+        componentId: 'ListeningCard',
+        dataModel: { intent: 'Lyssnar på användaren' }
+      });
+    });
+
+    // Så ska ListeningCard visas med rätt text
+    const cardElement = screen.getByText(/Lyssnar på användaren/i);
+    expect(cardElement).toBeDefined();
+
+    // När händelsen a2ui:clear publiceras
+    act(() => {
+      eventBus.publish('a2ui:clear', {});
+    });
+
+    // Så ska komponenten återgå till dolt läge
+    expect(container.firstChild).toBeNull();
+  });
+});
