diff --git a/src/features/path/__tests__/tck-064.test.ts b/src/features/path/__tests__/tck-064.test.ts
new file mode 100644
index 0000000..19a77ba
--- /dev/null
+++ b/src/features/path/__tests__/tck-064.test.ts
@@ -0,0 +1,72 @@
+import { describe, it, expect } from 'vitest';
+import { 
+  PromptCompileInputSchema, 
+  CompiledPromptSchema, 
+  ProvningsportOptionsSchema, 
+  BidiLiveAdapterConfigSchema, 
+  OrchestratorConfigSchema 
+} from '../src/features/path/contracts/pathSchema';
+import type { StepNode, PortNode } from '../src/features/path/model/types';
+import { z } from 'zod';
+
+describe('TCK-064 Harmoniseringskontroll', () => {
+  it('ska validera uppdaterade Zod-scheman i pathSchema.ts', () => {
+    // 1. Kontrollera PromptCompileInputSchema (inga duplicerade nycklar, använder z.record)
+    const promptCompileInput = PromptCompileInputSchema.parse({
+      id: 'test-1',
+      metadata: { key: 'value' }
+    });
+    expect(promptCompileInput.id).toBe('test-1');
+    
+    // Testa z.record struktur
+    const recordCheck = z.record(z.string(), z.unknown()).parse({ extra: 123 });
+    expect(recordCheck.extra).toBe(123);
+
+    // 2. Kontrollera CompiledPromptSchema med systemPrompt
+    const compiledPrompt = CompiledPromptSchema.parse({
+      template: 'tpl',
+      systemPrompt: 'sys-prompt'
+    });
+    expect(compiledPrompt.systemPrompt).toBe('sys-prompt');
+
+    // 3. Kontrollera ProvningsportOptionsSchema med testKod
+    const provningsportOptions = ProvningsportOptionsSchema.parse({
+      testKod: 'console.log("test");'
+    });
+    expect(provningsportOptions.testKod).toBe('console.log("test");');
+
+    // 4. Kontrollera BidiLiveAdapterConfigSchema med default maxReconnectAttempts = 6
+    const bidiConfig = BidiLiveAdapterConfigSchema.parse({});
+    expect(bidiConfig.maxReconnectAttempts).toBe(6);
+
+    // 5. Kontrollera OrchestratorConfigSchema med uppdragsTyp och maxYttreOmvandelseForsok
+    const orchestratorConfig = OrchestratorConfigSchema.parse({});
+    expect(orchestratorConfig.uppdragsTyp).toBe('TCK');
+    expect(orchestratorConfig.maxYttreOmvandelseForsok).toBe(4);
+  });
+
+  it('ska säkerställa valfri run? på StepNode och PortNode', () => {
+    // Om typerna tillåter valfri run?, kan vi skapa objekt utan run
+    const stepNode: StepNode = {
+      id: 'step-1',
+      type: 'simple'
+      // run är utelämnat, vilket ska vara OK
+    };
+    expect(stepNode.id).toBe('step-1');
+
+    const portNode: PortNode = {
+      id: 'port-1',
+      name: 'port-name'
+      // run är utelämnat, vilket ska vara OK
+    };
+    expect(portNode.id).toBe('port-1');
+
+    // Kan även ha run definierat
+    const stepNodeWithRun: StepNode = {
+      id: 'step-2',
+      type: 'simple',
+      run: async () => {}
+    };
+    expect(stepNodeWithRun.id).toBe('step-2');
+  });
+});
