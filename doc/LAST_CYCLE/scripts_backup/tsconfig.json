{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.js"
  ]
}
